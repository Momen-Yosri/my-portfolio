---
import type { Project } from '../data/projects';
import { brandedApps } from '../data/apps';
import { u } from '../utils';

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
// three screens per project; the platform shows three of its branded apps
const shots = project.screenshots
  ? project.screenshots.slice(0, 3).map((s) => s.src)
  : brandedApps.slice(0, 3).map((a) => `apps/${a.slug}.webp`);
// centre phone first, then left and right
const phones = [shots[1], shots[0], shots[2]];
const stores = [
  { href: project.links.appStore, label: 'App Store' },
  { href: project.links.playStore, label: 'Google Play' },
].filter((s) => s.href);
const href = u(`projects/${project.slug}/`);
---

<article class="story" style={`--c:${project.color};--i:${index}`} data-reveal>
  <div class="copy">
    <p class="kicker mono"><span>{num}</span>{project.category}</p>
    <h3>
      {project.logo && <img src={u(project.logo)} alt="" width="52" height="52" loading="lazy" />}
      {project.name}
    </h3>
    <p class="short">{project.short}</p>
    <p class="outcome">{project.outcome}</p>
    <ul class="tags" aria-label="Technology">
      {project.stack.slice(0, 5).map((s) => <li class="tag">{s}</li>)}
    </ul>
    <div class="actions">
      <a class="btn btn-primary" href={href}>Read case study<span class="sr-only"> for {project.name}</span></a>
      {
        stores.map((s) => (
          <a class="btn" href={s.href} target="_blank" rel="noopener noreferrer">
            {s.label}
            <span class="sr-only"> (opens in a new tab) for {project.name}</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="visual" data-deck>
    <span class="word" aria-hidden="true">{project.name}</span>
    <div class="deck">
      {
        phones.map((src, i) => (
          <button
            type="button"
            class="phone"
            data-deck-card
            style={`--o:${[0, -1, 1][i]};--d:${[0, 1, 1][i]}`}
            aria-label={`Show ${project.name} screen ${i + 1}`}
          >
            <img src={u(src)} alt="" loading="lazy" decoding="async" draggable="false" />
          </button>
        ))
      }
    </div>
    <span class="hint mono" aria-hidden="true">tap a screen</span>
  </div>
</article>

<script>
  import '../scripts/deck';
</script>

<style>
  .story {
    --accent-2: color-mix(in srgb, var(--c) 58%, #000);
    --on-accent: #fff;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    min-height: 480px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 32px;
    background: var(--surface);
    box-shadow: 0 -10px 40px -24px rgba(18, 17, 15, 0.45);
  }
  .copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-width: 0;
    padding: clamp(1.5rem, 3.5vw, 3rem);
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
  }
  .kicker span {
    padding: 0.15rem 0.6rem;
    border-radius: 99px;
    background: var(--accent-2);
    color: #fff;
    font-weight: 700;
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.1rem;
    font-size: clamp(1.65rem, 3.2vw, 2.9rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  h3 img {
    flex: none;
    width: clamp(40px, 4vw, 52px);
    height: auto;
    border: 1px solid var(--border);
    border-radius: 23%;
  }
  .short {
    margin-top: 1rem;
    max-width: 32rem;
    font-size: 1.12rem;
    color: var(--text);
  }
  .outcome {
    margin-top: 0.85rem;
    max-width: 32rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--c);
    font-size: 0.95rem;
  }
  .tags {
    margin-top: 1.25rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  /* the colour panel: the project's identity */
  .visual {
    --w: clamp(110px, 13vw, 195px);
    position: relative;
    min-width: 0;
    min-height: calc(var(--w) * 2.12 + 4rem);
    overflow: hidden;
    background: color-mix(in srgb, var(--c) 66%, #0b0a0e);
  }
  .word {
    position: absolute;
    left: 50%;
    top: 4%;
    translate: -50% 0;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    color: #fff;
    opacity: 0.14;
  }
  .phone {
    position: absolute;
    top: calc(50% - var(--w) * 1.04);
    left: calc(50% - var(--w) / 2);
    width: var(--w);
    padding: 6px;
    border-radius: calc(var(--w) * 0.16);
    background: linear-gradient(150deg, #56606a, #0a0d10 35%, #0a0d10 70%, #39424a);
    box-shadow: 0 30px 60px -22px rgba(0, 0, 0, 0.75);
    transition: transform 0.8s var(--ease);
  }
  .phone img {
    width: 100%;
    aspect-ratio: 9 / 18.6;
    object-fit: cover;
    object-position: top;
    border-radius: calc(var(--w) * 0.16 - 6px);
  }
  /* cards stack like layers while scrolling, only where they fit the screen */
  @media (min-width: 900px) and (min-height: 640px) {
    .story {
      position: sticky;
      top: calc(var(--nav-h) + 12px + var(--i) * 12px);
      height: min(540px, calc(100svh - var(--nav-h) - 80px));
      min-height: 0;
    }
    .visual {
      --w: min(13.5vw, calc((100svh - 230px) * 0.4), 195px);
      min-height: 0;
    }
  }
  @media (min-width: 900px) and (max-height: 760px) {
    .outcome,
    .tags {
      display: none;
    }
  }

  /* tablets and phones: colour panel on top, text below */
  @media (max-width: 899px) {
    .story {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      border-radius: 24px;
    }
    .visual {
      --w: clamp(112px, 30vw, 200px);
      order: -1;
    }
  }
  /* ---- interactive deck ---- */
  .story {
    --spread: 1;
  }
  .visual {
    perspective: 1100px;
    touch-action: pan-y;
    user-select: none;
  }
  /* light that follows the pointer */
  .visual::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(320px circle at var(--gx, 50%) var(--gy, 45%), rgba(255, 255, 255, 0.26), transparent 70%);
    pointer-events: none;
  }
  .word {
    transform: translate(calc(var(--tx, 0) * -60px), calc(var(--ty, 0) * -24px));
    transition: transform 0.4s var(--ease);
  }
  .deck {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateY(calc(var(--tx, 0) * 16deg)) rotateX(calc(var(--ty, 0) * -10deg));
    transition: transform 0.35s var(--ease);
  }
  .phone {
    z-index: calc(3 - var(--d));
    cursor: pointer;
    border: 0;
    transform: translate3d(calc(var(--o) * var(--w) * 0.82 * var(--spread)), calc(var(--d) * 14px), calc(var(--d) * -60px))
      rotate(calc(var(--o) * 9deg * var(--spread))) scale(calc(1 - var(--d) * 0.12));
    filter: brightness(calc(1 - var(--d) * 0.18));
    transition:
      transform 0.7s cubic-bezier(0.34, 1.3, 0.5, 1),
      filter 0.4s;
  }
  .phone img {
    display: block;
    pointer-events: none;
  }
  .phone:hover,
  .phone:focus-visible {
    filter: none;
  }
  .visual:hover {
    --spread: 1.18;
  }
  .hint {
    position: absolute;
    bottom: 0.9rem;
    left: 50%;
    translate: -50% 0;
    padding: 0.2rem 0.7rem;
    border-radius: 99px;
    background: rgba(0, 0, 0, 0.35);
    color: #fff;
    font-size: 0.68rem;
    white-space: nowrap;
    pointer-events: none;
  }
  :global(html:not(.js)) .hint {
    display: none;
  }
  /* the copy slides in after the card arrives */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .story:not(:global(.in)) {
      --spread: 0;
    }
    :global(html.js) .story .copy > * {
      transition:
        opacity 0.6s var(--ease),
        translate 0.6s var(--ease);
    }
    :global(html.js) .story:not(:global(.in)) .copy > * {
      opacity: 0;
      translate: -28px 0;
    }
    .copy > :nth-child(2) {
      transition-delay: 0.08s !important;
    }
    .copy > :nth-child(3) {
      transition-delay: 0.16s !important;
    }
    .copy > :nth-child(4) {
      transition-delay: 0.24s !important;
    }
    .copy > :nth-child(5) {
      transition-delay: 0.3s !important;
    }
    .copy > :nth-child(6) {
      transition-delay: 0.36s !important;
    }
  }
</style>
