---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.jpg';
import { profile } from '../data/profile';
import { brandedApps } from '../data/apps';
import { u } from '../utils';

// Platform apps, plus other apps I worked on.
const ring = [
  ...brandedApps.map((a) => ({ ...a, file: `apps/${a.slug}` })),
  { name: 'Qanoni', color: '#0c0c0d', primary: '#2a1247', glow: '#a46bd6', file: 'screens/qanoni/splash' },
];
// Qanoni sits second so it comes round early.
ring.splice(1, 0, ring.pop()!);
const apps = ring.map((a) => ({ ...a, video: u(`${a.file}.mp4`), poster: u(`${a.file}.webp`) }));
const first = apps[0];
const words = profile.headline.split(' ');
const step = 360 / apps.length;
---

<section id="home" class="hero ink" aria-labelledby="hero-title" data-hero style={`--primary:${first.primary}`}>
  <div class="floor" aria-hidden="true"><i></i></div>

  <p class="giant" aria-hidden="true" data-giant><bdi>{first.name}</bdi></p>

  <div class="layout container">
  <div class="head">
    <p class="who">
      <Image src={profilePhoto} alt="" width={88} height={110} format="webp" loading="eager" />
      <span><b>{profile.name}</b> {profile.role} · {profile.company}</span>
    </p>
    <h1 id="hero-title">
      {
        words.map((w, i) => (
          <Fragment>
            <span class:list={['mask', { accent: i >= words.length - 2 }]}>
              <span class="word" style={`--i:${i}`}>{w}</span>
            </span>{' '}
          </Fragment>
        ))
      }
    </h1>
  </div>

  <div class="show">
  <div class="stage" data-stage>
    <ul class="ring" data-ring aria-label="Apps I have built and worked on. Drag to rotate.">
      {
        apps.map((a, i) => (
          <li style={`--a:${i * step}deg;--c:${a.color}`}>
            <button type="button" data-card data-name={a.name} data-primary={a.primary} data-video={a.video} aria-label={`Show ${a.name}`}>
              {/* only the front phone and its neighbours are visible at first */}
              <img src={a.poster} alt="" width="540" height="960" draggable="false" fetchpriority={i < 2 || i === apps.length - 1 ? 'high' : 'low'} />
            </button>
          </li>
        ))
      }
    </ul>
  </div>

    <div class="switcher mono">
      <button type="button" data-prev aria-label="Previous app">←</button>
      <p>
        <b data-current><bdi>{first.name}</bdi></b>
      </p>
      <button type="button" data-next aria-label="Next app">→</button>
      <button type="button" data-pause aria-pressed="false">Pause</button>
    </div>
  </div>

  <div class="dock">
    <p class="lead">{profile.heroText}</p>
    <div class="actions">
      <a class="btn btn-primary" href="#projects">View my work</a>
      <a class="btn" href="#contact">Contact me</a>
      <a class="btn" href={u(profile.cv)} download>Download CV</a>
      <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
  </div>
</section>

<script>
  import '../scripts/hero';
</script>

<style>
  @property --brand {
    syntax: '<color>';
    inherits: true;
    initial-value: #7cc8ff;
  }
  .hero {
    --w: clamp(112px, 22svh, 230px);
    position: relative;
    padding-block: clamp(0.75rem, 2svh, 2rem);
    overflow: hidden;
    text-align: center;
    isolation: isolate;
  }
  .hero {
    --accent-2: var(--brand);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(60% 42% at 50% 54%, color-mix(in srgb, var(--brand) 34%, transparent), transparent 100%);
  }
  /* perspective grid floor, scrolling toward the viewer */
  .floor {
    position: absolute;
    inset: 42% 0 0;
    z-index: -1;
    overflow: hidden;
    perspective: 340px;
    mask-image: linear-gradient(transparent, #000 35%, transparent 92%);
    -webkit-mask-image: linear-gradient(transparent, #000 35%, transparent 92%);
  }
  .floor i {
    position: absolute;
    inset: -60% -60% -20%;
    transform: rotateX(68deg);
    background:
      linear-gradient(color-mix(in srgb, var(--brand) 45%, transparent) 1px, transparent 1px) 0 0 / 100% 56px,
      linear-gradient(90deg, color-mix(in srgb, var(--brand) 45%, transparent) 1px, transparent 1px) 0 0 / 56px 100%;
    opacity: 0.55;
  }
  .who {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.3rem 1.1rem 0.3rem 0.35rem;
    border: 1px solid var(--border-strong);
    border-radius: 99px;
    background: rgba(5, 5, 5, 0.6);
    font-size: 0.85rem;
    text-align: left;
  }
  .who img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 8%;
    border: 2px solid var(--brand);
  }
  .who b {
    display: block;
    color: var(--text);
  }
  h1 {
    margin: 0.75rem auto 0;
    font-size: clamp(2.2rem, min(5vw, 7.5svh), 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    font-weight: 750;
    max-width: 24ch;
    text-wrap: balance;
  }
  .mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: 0 0.04em 0.14em;
    margin: 0 -0.04em -0.1em;
  }
  .word {
    display: inline-block;
  }
  .accent .word {
    color: color-mix(in srgb, var(--brand) 78%, #fff);
  }
  .stage {
    height: calc(var(--w) * 1.78 + 2.5rem);
    display: grid;
    place-items: center;
    perspective: 1300px;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .stage:active {
    cursor: grabbing;
  }
  .ring {
    --r: calc(var(--w) * 1.75);
    position: relative;
    width: var(--w);
    aspect-ratio: 9 / 16;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--r) * -1)) rotateX(-4deg) rotateY(var(--turn, 0deg));
  }
  .ring li {
    position: absolute;
    inset: 0;
    transform: rotateY(var(--a)) translateZ(var(--r));
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    opacity: var(--o, 1);
  }
  .ring button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 5px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 24px;
    background: #05080a;
    cursor: pointer;
    box-shadow: 0 30px 50px -24px rgba(0, 0, 0, 0.9);
    transition:
      box-shadow 0.4s,
      border-color 0.4s;
  }
  .ring li:global(.front) button {
    border-color: var(--brand);
    box-shadow: 0 0 60px -8px var(--brand);
  }
  .ring img,
  .ring :global(video) {
    position: absolute;
    top: 5px;
    left: 5px;
    width: calc(100% - 10px);
    height: calc(100% - 10px);
    object-fit: cover;
    border-radius: 19px;
    background: var(--c);
    pointer-events: none;
  }
  .switcher {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
  }
  .switcher p {
    min-width: min(21rem, 70vw);
    color: var(--text);
  }
  .switcher b {
    color: color-mix(in srgb, var(--brand) 78%, #fff);
  }
  .switcher button {
    min-width: 40px;
    min-height: 40px;
    padding: 0 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: 99px;
    background: rgba(5, 5, 5, 0.7);
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
  .switcher button:hover {
    border-color: var(--brand);
  }
  .lead {
    margin: 0.75rem auto 0;
    max-width: 46rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .actions {
    margin-top: 0.9rem;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 560px) {
    .hero {
      --w: 140px;
    }
    .switcher p {
      min-width: 12.5rem;
      font-size: 0.72rem;
    }
  }
  :global(html:not(.js)) .switcher {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .word {
      animation: slide 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(0.15s + var(--i) * 110ms);
    }
    .who,
    .dock > * {
      animation: rise 0.8s var(--ease) 0.2s both;
    }
    .dock > * {
      animation-delay: 0.7s;
    }
    .stage {
      animation: arrive 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.35s backwards;
    }
    .floor i {
      animation: travel 2.4s linear infinite;
      will-change: transform;
    }
    @keyframes slide {
      from {
        transform: translateY(115%) rotate(4deg);
      }
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
    }
    @keyframes arrive {
      from {
        opacity: 0;
        transform: translateY(120px) scale(0.7);
      }
    }
    @keyframes travel {
      from {
        transform: rotateX(68deg) translateY(0);
      }
      to {
        transform: rotateX(68deg) translateY(56px);
      }
    }
  }
  /* ---- large-mockup layout ---- */
  .hero {
    --w: clamp(190px, 34svh, 320px);
    padding-block: clamp(1rem, 3svh, 2.5rem);
  }
  .layout {
    display: grid;
    grid-template-areas: 'head' 'show' 'dock';
    grid-template-columns: minmax(0, 1fr);
  }
  .head {
    grid-area: head;
  }
  .show {
    grid-area: show;
    min-width: 0;
  }
  .dock {
    grid-area: dock;
  }
  .stage {
    height: calc(var(--w) * 2.1 + 1rem);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .ring {
    --r: calc(var(--w) * 1.7);
    aspect-ratio: 9 / 17.5;
  }
  .switcher {
    display: flex;
  }
  /* phone body and camera island */
  .ring button {
    padding: 0;
    border: 0;
    border-radius: calc(var(--w) * 0.16);
    background: linear-gradient(150deg, #56606a, #0a0d10 35%, #0a0d10 70%, #39424a);
  }
  .ring li:global(.front) button {
    box-shadow:
      0 0 0 1px var(--brand),
      0 0 70px -10px var(--brand);
  }
  .ring button::after {
    content: '';
    position: absolute;
    z-index: 2;
    top: calc(var(--w) * 0.065);
    left: 50%;
    width: 30%;
    height: calc(var(--w) * 0.08);
    translate: -50% 0;
    border-radius: 99px;
    background: #030405;
  }
  .ring img,
  .ring :global(video) {
    top: 7px;
    left: 7px;
    width: calc(100% - 14px);
    height: calc(100% - 14px);
    border-radius: calc(var(--w) * 0.16 - 7px);
  }
  @media (min-width: 1000px) {
    .hero {
      --w: clamp(220px, 35.5svh, 330px);
      display: grid;
      align-items: center;
      min-height: calc(100svh - var(--nav-h));
      text-align: left;
    }
    .layout {
      grid-template-areas: 'head show' 'dock show';
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      grid-template-rows: auto auto;
      align-content: center;
      column-gap: 2rem;
    }
    .head {
      align-self: end;
    }
    .dock {
      align-self: start;
    }
    h1 {
      margin: 1.25rem 0 0;
      font-size: clamp(2.6rem, min(4.8vw, 10svh), 4.8rem);
      max-width: 11ch;
    }
    .lead {
      margin: 1.25rem 0 0;
      max-width: 32rem;
      font-size: 1.05rem;
    }
    .actions {
      justify-content: flex-start;
      margin-top: 1.5rem;
    }
  }
  @media (max-width: 999px) {
    .hero {
      --w: clamp(200px, 56vw, 280px);
    }
  }
  @media (min-width: 1000px) {
    .actions {
      gap: 0.5rem;
    }
    .actions .btn {
      padding-inline: 0.85rem;
      white-space: nowrap;
    }
  }
  /* ---- smooth, uncropped carousel ---- */
  .stage {
    height: calc(var(--w) * 1.95 + 3rem);
    overflow: visible;
    mask-image: none;
    -webkit-mask-image: none;
  }
  .ring {
    transform: translateZ(calc(var(--r) * -1));
    will-change: transform;
  }
  .ring button {
    box-shadow: none;
    transition: none;
  }
  .ring li:global(.front) button {
    box-shadow:
      0 0 0 1px var(--brand),
      0 0 36px -8px var(--brand);
  }
  .head,
  .dock {
    position: relative;
    z-index: 2;
  }
  .switcher {
    flex-wrap: nowrap;
    gap: 0.6rem;
  }
  .switcher p {
    min-width: min(17rem, 48vw);
    line-height: 1.15;
    text-align: center;
  }
  .switcher p b {
    display: block;
    font-family: var(--font-sans);
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    font-weight: 750;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .switcher p :global(bdi.in) {
      display: inline-block;
      animation: name-in 0.45s var(--ease);
    }
    @keyframes name-in {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
    }
  }
  /* keep arrows and name centred under the phone: Pause must not shift them */
  .switcher [data-pause] {
    width: 5rem;
  }
  @media (min-width: 561px) {
    .switcher::before {
      content: '';
      width: 5rem;
    }
  }
  @media (max-width: 560px) {
    .switcher {
      flex-wrap: wrap;
    }
    .switcher p {
      min-width: calc(100vw - 11rem);
    }
  }
</style>
