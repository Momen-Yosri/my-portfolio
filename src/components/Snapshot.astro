---
import { snapshot } from '../data/profile';
---

<section class="snap" aria-label="Professional snapshot">
  <div class="container">
    <ul class="grid">
      {
        snapshot.map((s, i) => (
          <li data-reveal style={`--d:${i * 60}ms`}>
            <span
              class="num"
              data-count-to={s.to}
              data-prefix={s.prefix ?? ''}
              data-suffix={s.suffix ?? ''}
            >
              {s.text ?? `${s.prefix ?? ''}${s.to}${s.suffix ?? ''}`}
            </span>
            <span class="label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .snap {
    border-block: 1px solid var(--border);
    background: rgba(5, 5, 5, 0.45);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  li {
    padding: 2rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-left: 1px solid var(--border);
  }
  li:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .num {
    font-size: clamp(1.9rem, 3.2vw, 2.6rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .label {
    font-size: 0.84rem;
    line-height: 1.4;
    color: var(--text-2);
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    li:nth-child(3n + 1) {
      border-left: 0;
      padding-left: 0;
    }
    li:nth-child(n + 4) {
      border-top: 1px solid var(--border);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    li {
      padding: 1.5rem 1rem;
      border-left: 1px solid var(--border);
    }
    li:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
    li:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
</style>
