---
import type { Project } from '../data/projects';
import { u } from '../utils';

interface Props {
  project: Project;
  index: number;
  wide?: boolean;
}
const { project, index, wide = false } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article class:list={['card pcard', { wide }]} data-reveal style={`--d:${(index % 2) * 80}ms`}>
  <div class:list={['cover', { shots: project.screenshots || project.logo }]} aria-hidden="true">
    {
      project.screenshots?.slice(0, 2).map((s, i) => (
        <img class:list={['peek', `peek-${i}`]} src={u(s.src)} alt="" loading="lazy" />
      ))
    }
    {!project.screenshots && project.logo && <img class="hero-logo" src={u(project.logo)} alt="" loading="lazy" />}
    <span class="num mono">{num}</span>
    <span class="cat mono">{project.category}</span>
  </div>
  <div class="body">
    {project.screenshots && project.logo && <img class="logo" src={u(project.logo)} alt="" width="56" height="56" loading="lazy" />}
    <p class="platform mono">{project.platform}</p>
    <h3>
      <a class="stretch" href={u(`projects/${project.slug}/`)}>{project.name}</a>
    </h3>
    <p class="short">{project.short}</p>
    <ul class="tags" aria-label="Technology">
      {project.stack.slice(0, wide ? 7 : 5).map((s) => <li class="tag">{s}</li>)}
    </ul>
    <div class="foot">
      <span class="more">Read case study <span aria-hidden="true">→</span></span>
      <span class="stores">
        {
          project.links.appStore && (
            <a class="store" href={project.links.appStore} target="_blank" rel="noopener noreferrer">
              App Store<span class="sr-only"> (opens in a new tab) for {project.name}</span>
            </a>
          )
        }
        {
          project.links.playStore && (
            <a class="store" href={project.links.playStore} target="_blank" rel="noopener noreferrer">
              Google Play<span class="sr-only"> (opens in a new tab) for {project.name}</span>
            </a>
          )
        }
      </span>
    </div>
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }
  .pcard:hover,
  .pcard:focus-within {
    border-color: rgba(46, 230, 168, 0.5);
    translate: 0 -5px;
    box-shadow: 0 28px 56px -28px rgba(46, 230, 168, 0.85);
  }
  .cover {
    position: relative;
    height: 150px;
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    background:
      linear-gradient(rgba(197, 208, 205, 0.07) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, rgba(197, 208, 205, 0.07) 1px, transparent 1px) 0 0 / 28px 28px,
      radial-gradient(120% 140% at 100% 0%, rgba(46, 230, 168, 0.28), rgba(7, 10, 12, 0.1) 70%),
      radial-gradient(90% 120% at 0% 100%, rgba(255, 197, 97, 0.16), transparent 70%);
    border-bottom: 1px solid var(--border);
  }
  .wide .cover {
    height: 190px;
  }
  .cover.shots {
    height: 250px;
    overflow: hidden;
  }
  .peek {
    position: absolute;
    top: 62px;
    width: 130px;
    border-radius: 16px;
    border: 1px solid var(--border-strong);
    box-shadow: 0 20px 40px -16px rgba(0, 0, 0, 0.85);
    transition:
      translate 0.45s var(--ease),
      rotate 0.45s var(--ease);
  }
  .peek-0 {
    left: calc(50% - 118px);
    rotate: -7deg;
  }
  .peek-1 {
    left: calc(50% - 4px);
    top: 84px;
    rotate: 7deg;
  }
  .pcard:hover .peek {
    translate: 0 -16px;
  }
  .pcard:hover .peek-0 {
    rotate: -10deg;
  }
  .pcard:hover .peek-1 {
    rotate: 10deg;
  }
  .logo {
    width: 56px;
    height: 56px;
    border-radius: 23%;
    border: 1px solid var(--border-strong);
  }
  .hero-logo {
    position: absolute;
    left: 50%;
    top: 56%;
    width: 128px;
    translate: -50% -50%;
    border-radius: 23%;
    border: 1px solid var(--border-strong);
    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.85);
    transition: scale 0.45s var(--ease);
  }
  .pcard:hover .hero-logo {
    scale: 1.1;
  }
  .num {
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: -0.04em;
  }
  .cat {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
    padding: 0.25rem 0.55rem;
    border: 1px solid rgba(46, 230, 168, 0.35);
    border-radius: 6px;
    background: rgba(7, 10, 12, 0.5);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    flex: 1;
  }
  .platform {
    font-size: 0.72rem;
    color: var(--text-3);
  }
  h3 {
    font-size: 1.4rem;
  }
  .stretch {
    color: var(--text);
  }
  .stretch:hover {
    text-decoration: none;
  }
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .short {
    color: var(--text-2);
  }
  .tags {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.88rem;
  }
  .more {
    color: var(--text);
    font-weight: 550;
    transition: color 0.2s;
  }
  .more span {
    display: inline-block;
    transition: transform 0.25s var(--ease);
  }
  .pcard:hover .more {
    color: var(--accent-2);
  }
  .pcard:hover .more span {
    transform: translateX(4px);
  }
  .stores {
    display: flex;
    gap: 0.9rem;
    position: relative;
    z-index: 2;
  }
  .store {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding-block: 0.4rem;
  }

  @media (min-width: 900px) {
    .wide {
      flex-direction: row;
    }
    .wide .cover {
      width: 38%;
      height: auto;
      min-height: 100%;
      border-bottom: 0;
      border-right: 1px solid var(--border);
      align-items: flex-start;
    }
    .wide .num {
      font-size: 4rem;
    }
    .wide .body {
      padding: 2rem 2.25rem;
    }
    .wide h3 {
      font-size: 1.9rem;
    }
    .wide .short {
      font-size: 1.1rem;
      max-width: 36rem;
    }
  }
  .cover.shots {
    height: 190px;
  }
  .body {
    gap: 0.6rem;
    padding: 1.25rem;
  }
  .logo {
    position: absolute;
    right: 1.25rem;
    margin-top: -0.25rem;
    width: 44px;
    height: 44px;
  }
  .peek {
    top: 48px;
    width: 104px;
  }
  .peek-0 {
    left: calc(50% - 94px);
  }
  .peek-1 {
    top: 66px;
  }
  .hero-logo {
    width: 104px;
  }
  @media (min-width: 900px) {
    .wide .cover.shots,
    .wide .cover {
      height: auto;
      min-height: 100%;
    }
  }
  @media (min-width: 1100px) {
    .pcard:not(.wide) h3 {
      font-size: 1.15rem;
    }
    .pcard:not(.wide) .short {
      font-size: 0.92rem;
    }
    .pcard:not(.wide) .tags {
      display: none;
    }
    .pcard:not(.wide) .foot {
      margin-top: auto;
    }
    .wide .body {
      padding-block: 1.5rem;
    }
  }
</style>
