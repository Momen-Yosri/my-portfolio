---
import { nav, profile } from '../data/profile';
import { u } from '../utils';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const prefix = home ? '' : u('');
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={home ? '#home' : u('')} aria-label={`${profile.name}, home`}>
      <span class="mark" aria-hidden="true">{profile.monogram}</span>
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul id="nav-menu" class="menu" data-open="false">
        {
          nav.map((n) => (
            <li>
              <a href={`${prefix}${n.href}`} data-nav-link>
                {n.label}
              </a>
            </li>
          ))
        }
        <li class="cta-mobile">
          <a class="btn btn-primary" href={`mailto:${profile.email}`}>Email me</a>
        </li>
      </ul>
    </nav>

    <a class="btn btn-primary btn-sm cta-desktop" href={`mailto:${profile.email}`}>Email me</a>

    <button
      class="toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Toggle navigation menu"
    >
      <span class="bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease),
      backdrop-filter 0.3s;
  }
  :global(.site-header.scrolled) {
    background: rgba(7, 10, 12, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand:hover {
    text-decoration: none;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(140deg, var(--accent), #12805c);
    border: 1px solid rgba(46, 230, 168, 0.4);
  }
  .menu {
    display: flex;
    gap: 0.25rem;
  }
  .menu a[data-nav-link] {
    display: block;
    padding: 0.5rem 0.8rem;
    color: var(--text-2);
    font-size: 0.92rem;
    font-weight: 500;
    border-radius: 8px;
    transition: color 0.2s;
  }
  .menu a[data-nav-link]:hover,
  .menu a[data-nav-link][aria-current='true'] {
    color: var(--text);
    text-decoration: none;
  }
  .menu a[data-nav-link][aria-current='true'] {
    background: rgba(46, 230, 168, 0.1);
  }
  .cta-mobile,
  .toggle {
    display: none;
  }

  @media (max-width: 999px) {
    .cta-desktop {
      display: none;
    }
    .toggle {
      display: inline-grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--border-strong);
      border-radius: 10px;
      background: transparent;
      color: var(--text);
      cursor: pointer;
    }
    .bars,
    .bars::before,
    .bars::after {
      display: block;
      width: 18px;
      height: 2px;
      background: currentColor;
      border-radius: 2px;
      transition:
        transform 0.25s var(--ease),
        opacity 0.2s;
    }
    .bars {
      position: relative;
    }
    .bars::before,
    .bars::after {
      content: '';
      position: absolute;
      left: 0;
    }
    .bars::before {
      top: -6px;
    }
    .bars::after {
      top: 6px;
    }
    .toggle[aria-expanded='true'] .bars {
      background: transparent;
    }
    .toggle[aria-expanded='true'] .bars::before {
      transform: translateY(6px) rotate(45deg);
    }
    .toggle[aria-expanded='true'] .bars::after {
      transform: translateY(-6px) rotate(-45deg);
    }
    .menu {
      position: fixed;
      inset: var(--nav-h) 0 0 0;
      flex-direction: column;
      gap: 0;
      padding: 1rem var(--gutter) 2rem;
      background: rgba(7, 10, 12, 0.98);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.25s var(--ease),
        transform 0.25s var(--ease),
        visibility 0s 0.25s;
    }
    .menu[data-open='true'] {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
    .menu a[data-nav-link] {
      font-size: 1.15rem;
      padding: 1rem 0.25rem;
      border-radius: 0;
      border-bottom: 1px solid var(--border);
      background: none !important;
    }
    .cta-mobile {
      display: block;
      margin-top: 1.5rem;
    }
    .cta-mobile .btn {
      width: 100%;
    }
  }

  /* No JS: show a static, wrapped menu instead of a hidden one */
  :global(html:not(.js)) .toggle {
    display: none;
  }
  @media (max-width: 999px) {
    :global(html:not(.js)) .site-header {
      height: auto;
      position: static;
    }
    :global(html:not(.js)) .bar {
      flex-wrap: wrap;
      padding-block: 0.75rem;
    }
    :global(html:not(.js)) .menu {
      position: static;
      visibility: visible;
      opacity: 1;
      transform: none;
      flex-direction: row;
      flex-wrap: wrap;
      padding: 0;
      background: none;
    }
  }

  /* eight links get tight on small laptops: keep everything on one line */
  .brand,
  .cta-desktop {
    white-space: nowrap;
  }
  @media (min-width: 1000px) and (max-width: 1150px) {
    .brand-name {
      display: none;
    }
    .menu {
      gap: 0;
    }
  }
</style>
