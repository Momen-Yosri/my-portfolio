---
import { u } from '../utils';

interface Props {
  shots: { src: string; alt: string }[];
  label: string;
}
const { shots, label } = Astro.props;
---

<ul class="gallery" tabindex="0" aria-label={label}>
  {
    shots.map((s) => (
      <li>
        <img src={u(s.src)} alt={s.alt} loading="lazy" decoding="async" />
      </li>
    ))
  }
</ul>

<style>
  /* let the strip scroll inside grid layouts instead of widening them */
  :global(:has(> .gallery)) {
    min-width: 0;
  }
  .gallery {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block: 0.5rem 1.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--accent) transparent;
  }
  li {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }
  img {
    display: block;
    height: clamp(380px, 58vh, 520px);
    width: auto;
    max-width: none;
    border-radius: 20px;
    border: 1px solid var(--border-strong);
    transition: translate 0.3s var(--ease);
  }
  li:hover img {
    translate: 0 -6px;
  }
  img {
    height: clamp(320px, 52svh, 440px);
  }
</style>
