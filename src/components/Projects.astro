---
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
import PlatformCard from './PlatformCard.astro';
import QanoniSpotlight from './QanoniSpotlight.astro';
import AlsoWorkedOn from './AlsoWorkedOn.astro';
import { projects } from '../data/projects';
---

<section id="projects" class="section" aria-labelledby="proj-title">
  <div class="container">
    <SectionHeading
      eyebrow="Featured projects"
      title="Products shipped to the App Store and Google Play."
      lead="Five case studies covering platform architecture, university learning, offline-first tooling and production maintenance."
      id="proj-title"
    />
    <div class="grid">
      {projects.map((p, i) => (i === 0 ? <PlatformCard project={p} /> : <ProjectCard project={p} index={i} />))}
    </div>

    <QanoniSpotlight />
    <AlsoWorkedOn />
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .grid > :global(:first-child) {
    grid-column: 1 / -1;
  }
  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
