---
import type { Project } from '../data/projects';
import { brandedApps } from '../data/apps';
import { u } from '../utils';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const mid = (brandedApps.length - 1) / 2;
---

<article class="card platform-card" data-reveal style={`--accent-2:${project.color}`}>
  <div class="text">
    <p class="kicker mono">01 · {project.category}</p>
    <h3><a class="stretch" href={u(`projects/${project.slug}/`)}>{project.name}</a></h3>
    <p class="short">{project.short}</p>
    <div class="foot">
      <span class="more">Read case study <span aria-hidden="true">→</span></span>
      {
        project.links.appStore && (
          <a class="store mono" href={project.links.appStore} target="_blank" rel="noopener noreferrer">
            App Store<span class="sr-only"> (opens in a new tab), reference app</span>
          </a>
        )
      }
      {
        project.links.playStore && (
          <a class="store mono" href={project.links.playStore} target="_blank" rel="noopener noreferrer">
            Google Play<span class="sr-only"> (opens in a new tab), reference app</span>
          </a>
        )
      }
    </div>
  </div>

  <div class="visual" aria-hidden="true">
    <ul class="fan">
      {
        brandedApps.map((a, i) => (
          <li style={`--o:${i - mid};z-index:${10 - Math.round(Math.abs(i - mid))}`}>
            <img src={u(`apps/${a.slug}.webp`)} alt="" width="72" height="128" loading="lazy" />
          </li>
        ))
      }
    </ul>
    <p class="core mono">tech_app_core</p>
  </div>
</article>

<style>
  .platform-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 1.75rem;
    overflow: hidden;
    border-color: color-mix(in srgb, var(--accent-2) 30%, transparent);
  }
  .platform-card:hover,
  .platform-card:focus-within {
    border-color: color-mix(in srgb, var(--accent-2) 70%, transparent);
  }
  .kicker {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
  }
  h3 {
    margin-top: 0.5rem;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
  }
  .stretch {
    color: var(--text);
  }
  .stretch:hover {
    text-decoration: none;
  }
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 11;
  }
  .short {
    margin-top: 0.5rem;
    max-width: 30rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
    font-size: 0.88rem;
  }
  .more {
    color: var(--text);
    font-weight: 550;
  }
  .store {
    position: relative;
    z-index: 12;
    font-size: 0.76rem;
    padding-block: 0.3rem;
  }
  /* a hand of phones; spreads on hover */
  .visual {
    --step: clamp(22px, 3.4vw, 46px);
    min-width: 0;
    text-align: center;
  }
  .fan {
    position: relative;
    height: 150px;
  }
  .fan li {
    position: absolute;
    top: 8px;
    left: calc(50% - 36px);
    transform: translate(calc(var(--o) * var(--step)), calc(var(--o) * var(--o) * 1.1px))
      rotate(calc(var(--o) * 3.5deg));
    transition: transform 0.5s var(--ease);
  }
  .fan img {
    width: 72px;
    height: 128px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 10px 22px -8px rgba(0, 0, 0, 0.9);
  }
  .platform-card:hover .fan li {
    transform: translate(calc(var(--o) * var(--step) * 1.15), calc(var(--o) * var(--o) * 0.4px))
      rotate(calc(var(--o) * 1.5deg));
  }
  .core {
    margin-top: 0.25rem;
    font-size: 0.72rem;
    color: var(--text-3);
  }
  @media (max-width: 860px) {
    .platform-card {
      grid-template-columns: minmax(0, 1fr);
      padding: 1.25rem;
    }
    .visual {
      --step: clamp(22px, 6.5vw, 46px);
      order: -1;
    }
  }
</style>
