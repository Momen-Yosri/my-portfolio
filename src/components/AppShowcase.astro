---
import SectionHeading from './SectionHeading.astro';
import { brandedApps } from '../data/apps';
import { u } from '../utils';

interface Props {
  /** Case-study pages already have their own heading and link. */
  embedded?: boolean;
}
const { embedded = false } = Astro.props;
const apps = brandedApps.map((a) => ({
  ...a,
  video: u(`apps/${a.slug}.mp4`),
  poster: u(`apps/${a.slug}.webp`),
}));
const first = apps[0];
---

<section
  id={embedded ? undefined : 'apps'}
  class:list={['showcase', embedded ? 'embedded' : 'section']}
  aria-label={embedded ? 'Apps built on tech_app_core' : undefined}
  aria-labelledby={embedded ? undefined : 'apps-title'}
>
  <div class:list={[{ container: !embedded }]}>
    {
      !embedded && (
        <SectionHeading
          eyebrow="Built on tech_app_core"
          title="One core. Many identities."
          lead="Each of these apps opens with its own brand and runs on the shared Flutter foundation I designed. Pick one to play its splash screen."
          id="apps-title"
        />
      )
    }
    <div class="stage" data-showcase data-reveal style={`--glow:${first.glow}`}>
      <div class="device-wrap">
        <div class="device">
          <div class="screen" data-screen style={`background:${first.color}`}>
            <video
              muted
              playsinline
              preload="none"
              poster={first.poster}
              src={first.video}
              aria-label={`${first.name} splash screen`}></video>
          </div>
        </div>
      </div>

      <div class="side">
        <p class="now mono"><span data-count>01</span> / {String(apps.length).padStart(2, '0')}</p>
        <h3 data-name>{first.name}</h3>
        <div class="progress" aria-hidden="true"><i data-bar></i></div>
        <div class="controls">
          <button class="btn btn-sm" type="button" data-toggle>Play</button>
          <a class="btn btn-sm" data-store="appStore" href={first.links.appStore} target="_blank" rel="noopener noreferrer" hidden={!first.links.appStore}>
            App Store<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a class="btn btn-sm" data-store="playStore" href={first.links.playStore} target="_blank" rel="noopener noreferrer" hidden={!first.links.playStore}>
            Google Play<span class="sr-only"> (opens in a new tab)</span>
          </a>
          {!embedded && <a class="how" href={u('projects/white-label-academy-platform/')}>How the platform works →</a>}
        </div>
        <ul class="picker">
          {
            apps.map((a, i) => (
              <li>
                <button
                  type="button"
                  data-app
                  data-name={a.name}
                  data-video={a.video}
                  data-poster={a.poster}
                  data-color={a.color}
                  data-glow={a.glow}
                  data-app-store={a.links.appStore}
                  data-play-store={a.links.playStore}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  style={`--c:${a.color};--g:${a.glow}`}
                >
                  <img src={a.poster} alt="" loading="lazy" width="108" height="144" />
                  <span>{a.name}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/showcase';
</script>

<style>
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .embedded .stage {
    grid-template-columns: minmax(0, 250px) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .device-wrap {
    position: relative;
    width: 100%;
    max-width: 320px;
    justify-self: center;
  }
  .device-wrap::before {
    content: '';
    position: absolute;
    inset: 4% -18%;
    background: var(--glow);
    border-radius: 50%;
    opacity: 0.28;
    filter: blur(60px);
    transition: background 0.6s;
  }
  .device {
    position: relative;
    padding: 9px;
    border-radius: 44px;
    background: linear-gradient(150deg, #3a4a63, #0a111d 40%, #1c2739);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.8);
  }
  .screen {
    aspect-ratio: 9 / 16;
    border-radius: 36px;
    overflow: hidden;
    transition: background 0.4s;
  }
  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .screen.swap video {
    animation: swap 0.5s var(--ease);
  }
  @keyframes swap {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }
  .side {
    min-width: 0;
  }
  .now {
    font-size: 0.78rem;
    color: var(--text-3);
  }
  h3 {
    font-size: clamp(1.7rem, 3.5vw, 2.5rem);
    margin-top: 0.4rem;
  }
  .progress {
    height: 2px;
    margin-top: 1.25rem;
    background: var(--border);
  }
  .progress i {
    display: block;
    height: 100%;
    background: var(--glow);
    transform: scaleX(0);
    transform-origin: left;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .controls [hidden] {
    display: none;
  }
  .how {
    font-size: 0.9rem;
  }
  .picker {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: 0.9rem 0.75rem;
    margin-top: 2rem;
  }
  .picker button {
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-3);
    font: inherit;
    font-size: 0.75rem;
    line-height: 1.35;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    text-align: center;
  }
  .picker img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    background: var(--c);
    border-radius: 14px;
    border: 2px solid transparent;
    opacity: 0.6;
    transition:
      opacity 0.25s,
      transform 0.3s var(--ease),
      border-color 0.25s,
      box-shadow 0.3s;
  }
  .picker button:hover img,
  .picker button:focus-visible img {
    opacity: 1;
    transform: translateY(-4px);
  }
  .picker [aria-pressed='true'] {
    color: var(--text);
  }
  .picker [aria-pressed='true'] img {
    opacity: 1;
    border-color: var(--g);
    box-shadow: 0 10px 28px -10px var(--g);
  }
  :global(html:not(.js)) .controls button {
    display: none;
  }
  @media (max-width: 800px) {
    .stage,
    .embedded .stage {
      grid-template-columns: minmax(0, 1fr);
    }
    .device-wrap {
      max-width: 260px;
    }
  }
</style>
