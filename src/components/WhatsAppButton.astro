---
import { profile } from '../data/profile';
---

<a class="wa" href={profile.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp (opens in a new tab)">
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="none">
    <path
      d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3Z"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"></path>
    <path
      d="M9 7.8c-.5.3-1 1-1 1.9 0 1 .7 2.2 1.6 3.3 1.2 1.5 2.7 2.6 4.4 3.1 1.2.3 2.2-.3 2.5-1.1.1-.4.1-.7 0-.8l-2.100-1-.9 1.1c-.2.2-.4.2-.7.1-1.3-.6-2.3-1.5-3-2.7-.1-.2-.1-.4.1-.6l.6-.800-.9-2.2c-.2-.4-.4-.4-.6-.3Z"
      fill="currentColor"></path>
  </svg>
  <span class="tip" aria-hidden="true">Chat on WhatsApp</span>
</a>

<style>
  .wa {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #128c4a;
    color: #fff;
    box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.7);
    transition: scale 0.25s var(--ease);
  }
  .wa:hover {
    scale: 1.08;
  }
  .tip {
    position: absolute;
    right: calc(100% + 0.75rem);
    white-space: nowrap;
    padding: 0.35rem 0.7rem;
    border-radius: 8px;
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    font-size: 0.82rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .wa:hover .tip,
  .wa:focus-visible .tip {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wa::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 2px solid #25d366;
      animation: ping 2.4s ease-out 3;
      opacity: 0;
      pointer-events: none;
    }
    @keyframes ping {
      from {
        opacity: 0.9;
      }
      to {
        opacity: 0;
        scale: 1.6;
      }
    }
  }
</style>
